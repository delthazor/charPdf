BasedOnStyle: LLVM
FixNamespaceComments: false
BreakBeforeBraces: Allman
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 110

# Keep the return type on the same line as the function name; when a signature wraps, break the
# parameter list (with BinPackParameters: false) instead of isolating the return type.
AlwaysBreakAfterReturnType: None
PenaltyReturnTypeOnItsOwnLine: 2000

# Constructor init lists: either one line total, or one initializer per line (no partial wrapping)
ConstructorInitializerAllOnOneLineOrOnePerLine: true

# Allow one-liners (e.g. if (condition) return;)
AllowShortBlocksOnASingleLine: Always
AllowShortIfStatementsOnASingleLine: WithoutElse

# When a call/declaration wraps, put each argument/parameter on its own line (no bin-packing)
BinPackArguments: false
BinPackParameters: false
